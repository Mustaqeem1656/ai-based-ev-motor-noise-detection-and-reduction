# sim    = built-in simulator (bridge/live.py may still stream and takes over QD-01)
# bridge = software edition only (laptop mic + phone via bridge/live.py), no simulator
# serial = hardware edition: ESP32-S3 running firmware/quietdrive_s3 on SERIAL_PORT
SOURCE=sim
SERIAL_PORT=COM3
BAUD=921600
# MODEL_PATH=../bridge/models_esp32s3/quietdrive_model.joblib   (default: esp32s3 model, else the phone model)
# WHINE_ORDER=21        (sent to the device at connect; default = the model's whine_order)
# STOPPED_RPM=300
DB_URL=sqlite:///./quietdrive.db
SERVE_FRONTEND=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
